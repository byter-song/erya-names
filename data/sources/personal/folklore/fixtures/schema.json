{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://erya.local/schemas/folklore-fixture.json",
  "title": "Erya folklore verification fixture",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "moduleId",
    "schoolId",
    "ruleVersion",
    "title",
    "input",
    "expected",
    "sourceRefs"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "moduleId": {
      "enum": ["bazi_wuxing", "zodiac", "traditional", "name_hexagram", "five_grids"]
    },
    "schoolId": { "type": "string", "minLength": 1 },
    "ruleVersion": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "expected": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["pass", "notice", "conflict", "unknown"] },
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "facts": { "type": "object" },
        "uncertainty": { "type": "string" }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sourceId", "pageOrSection"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "pageOrSection": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "examples": [
    {
      "id": "zodiac-hint-example",
      "moduleId": "zodiac",
      "schoolId": "zodiac-radical-hints-v1",
      "ruleVersion": "1.0.0",
      "title": "生肖提示不形成硬过滤",
      "input": { "zodiac": "dragon", "name": "远山" },
      "expected": { "status": "notice", "facts": { "blocksProgression": false } },
      "sourceRefs": [{ "sourceId": "source-example", "pageOrSection": "待定位" }]
    }
  ]
}
